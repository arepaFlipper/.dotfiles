source-file ~/.dotfiles/tmux/base.tmux.conf.local

# -- windows & pane creation ---------------------------------------------------

tmux_conf_new_window_retain_current_path=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_new_session_prompt=false


# -- display -------------------------------------------------------------------

tmux_conf_theme_24b_colour=true

tmux_conf_theme_window_fg='default'
tmux_conf_theme_window_bg='default'

tmux_conf_theme_highlight_focused_pane=false

tmux_conf_theme_focused_pane_fg='default'
tmux_conf_theme_focused_pane_bg='#89b4fa'               # catppuccin blue

tmux_conf_theme_pane_border_style=thin

tmux_conf_theme_pane_border='#313244'                   # catppuccin surface0
tmux_conf_theme_pane_active_border='#fab387'            # catppuccin peach

tmux_conf_theme_pane_indicator='#f9e2af'                # catppuccin yellow
tmux_conf_theme_pane_active_indicator='#f9e2af'         # catppuccin yellow

tmux_conf_theme_message_fg='#1e1e2e'                    # catppuccin base
tmux_conf_theme_message_bg='#f9e2af'                    # catppuccin yellow
tmux_conf_theme_message_attr='bold'

tmux_conf_theme_message_command_fg='#cdd6f4'            # catppuccin text
tmux_conf_theme_message_command_bg='#1e1e2e'            # catppuccin base
tmux_conf_theme_message_command_attr='bold'

tmux_conf_theme_mode_fg='#1e1e2e'                       # catppuccin base
tmux_conf_theme_mode_bg='#fab387'                       # catppuccin peach
tmux_conf_theme_mode_attr='bold'

tmux_conf_theme_status_fg='#cdd6f4'                     # catppuccin text
tmux_conf_theme_status_bg='#1e1e2e'                     # catppuccin base
tmux_conf_theme_status_attr='none'

tmux_conf_theme_terminal_title='#h ❐ #S ● #I #W'

tmux_conf_theme_window_status_fg='#cdd6f4'              # catppuccin text
tmux_conf_theme_window_status_bg='#1e1e2e'              # catppuccin base
tmux_conf_theme_window_status_attr='none'
tmux_conf_theme_window_status_format='#{circled_window_index} #W'

tmux_conf_theme_window_status_current_fg='#1e1e2e'      # catppuccin base
tmux_conf_theme_window_status_current_bg='#cba6f7'      # catppuccin mauve
tmux_conf_theme_window_status_current_attr='bold'
tmux_conf_theme_window_status_current_format='#{circled_window_index} #W'

tmux_conf_theme_window_status_activity_fg='default'
tmux_conf_theme_window_status_activity_bg='default'
tmux_conf_theme_window_status_activity_attr='underscore'

tmux_conf_theme_window_status_bell_fg='#f38ba8'         # catppuccin red
tmux_conf_theme_window_status_bell_bg='default'
tmux_conf_theme_window_status_bell_attr='blink,bold'

tmux_conf_theme_window_status_last_fg='#6c7086'         # catppuccin overlay0
tmux_conf_theme_window_status_last_bg='default'
tmux_conf_theme_window_status_last_attr='none'

tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

tmux_conf_theme_status_left=' 🐱 #S | ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} '

tmux_conf_theme_status_right='#{prefix}#{pairing}#{synchronized} #{tasks_status} #{?battery_status, #{battery_status},}#{?battery_bar, #{battery_bar},}#{?battery_percentage, #{battery_percentage},} , %a %H:%M:%S , %d %b | #{username}#{root} #{@os_box} #{@local_ip} '

# status left style
tmux_conf_theme_status_left_fg='#1e1e2e,#cdd6f4,#1e1e2e'  # catppuccin base, text, base
tmux_conf_theme_status_left_bg='#f9e2af,#45475a,#94e2d5'  # catppuccin yellow, surface1, teal
tmux_conf_theme_status_left_attr='bold,none,none'

# status right style
tmux_conf_theme_status_right_fg='#cdd6f4,#cdd6f4,#1e1e2e' # catppuccin text, text, base
tmux_conf_theme_status_right_bg='#45475a,#313244,#94e2d5' # catppuccin surface1, surface0, teal
tmux_conf_theme_status_right_attr='none,none,bold'

# pairing indicator
tmux_conf_theme_pairing='👓 '
tmux_conf_theme_pairing_fg='none'
tmux_conf_theme_pairing_bg='none'
tmux_conf_theme_pairing_attr='none'

# prefix indicator
tmux_conf_theme_prefix='⌨ '
tmux_conf_theme_prefix_fg='none'
tmux_conf_theme_prefix_bg='none'
tmux_conf_theme_prefix_attr='none'

# root indicator
tmux_conf_theme_root='!'
tmux_conf_theme_root_fg='red'
tmux_conf_theme_root_bg='none'
tmux_conf_theme_root_attr='bold,blink'

# synchronized indicator
tmux_conf_theme_synchronized='🔒'
tmux_conf_theme_synchronized_fg='none'
tmux_conf_theme_synchronized_bg='none'
tmux_conf_theme_synchronized_attr='none'

# battery bar symbols
tmux_conf_battery_bar_symbol_full='◼'
tmux_conf_battery_bar_symbol_empty='◻'

tmux_conf_battery_bar_length='auto'
tmux_conf_battery_bar_palette='gradient'
tmux_conf_battery_hbar_palette='gradient'
tmux_conf_battery_vbar_palette='gradient'

tmux_conf_battery_status_charging='🔌 '
tmux_conf_battery_status_discharging='🔋 '

tmux_conf_theme_clock_colour='#94e2d5'  # catppuccin teal
tmux_conf_theme_clock_style='24'


# -- clipboard -----------------------------------------------------------------

tmux_conf_copy_to_os_clipboard=true


# -- user customizations -------------------------------------------------------

set -g mouse on
set -g status-right-length 200

# List of plugins
set -g @tpm_plugins '           \
    tmux-plugins/tpm            \
    tmux-plugins/tmux-sensible  \
    tmux-plugins/tmux-yank      \
    tmux-plugins/tmux-open      \
    chriszarate/tmux-tasks      \
'

set -g @tasks_manager 'taskwarrior'
set -g @tasks_format_begin '#[fg=#1e1e2e,bg=#f9e2af]'
set -g @tasks_format_end '#[fg=#cdd6f4,bg=#313244]'
set -g @tasks_icon_urgent '🔥'
set -g @tasks_icon_outstanding '+'

