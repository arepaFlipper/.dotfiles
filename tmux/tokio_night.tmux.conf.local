# -- navigation ----------------------------------------------------------------

#set -ga terminal-overrides "*:kUP3=\e[1;9A,*:kDN3=\e[1;9B,*:kRIT3=\e[1;9C,*:kLFT3=\e[1;9D"


# -- windows & pane creation ---------------------------------------------------

tmux_conf_new_window_retain_current_path=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_new_session_prompt=false


# -- display -------------------------------------------------------------------

tmux_conf_theme_24b_colour=true

tmux_conf_theme_window_fg='default'
tmux_conf_theme_window_bg='default'

tmux_conf_theme_highlight_focused_pane=false

tmux_conf_theme_focused_pane_fg='default'
tmux_conf_theme_focused_pane_bg='#7aa2f7'               # tokyo night blue

tmux_conf_theme_pane_border_style=thin

tmux_conf_theme_pane_border='#292e42'                   # tokyo night bg_highlight
tmux_conf_theme_pane_active_border='#ff9e64'            # tokyo night orange

tmux_conf_theme_pane_indicator='#e0af68'                # tokyo night yellow
tmux_conf_theme_pane_active_indicator='#e0af68'         # tokyo night yellow

tmux_conf_theme_message_fg='#1a1b26'                    # tokyo night bg
tmux_conf_theme_message_bg='#e0af68'                    # tokyo night yellow
tmux_conf_theme_message_attr='bold'

tmux_conf_theme_message_command_fg='#c0caf5'            # tokyo night fg
tmux_conf_theme_message_command_bg='#1a1b26'            # tokyo night bg
tmux_conf_theme_message_command_attr='bold'

tmux_conf_theme_mode_fg='#1a1b26'                       # tokyo night bg
tmux_conf_theme_mode_bg='#ff9e64'                       # tokyo night orange
tmux_conf_theme_mode_attr='bold'

tmux_conf_theme_status_fg='#c0caf5'                     # tokyo night fg
tmux_conf_theme_status_bg='#1a1b26'                     # tokyo night bg
tmux_conf_theme_status_attr='none'

tmux_conf_theme_terminal_title='#h ❐ #S ● #I #W'

tmux_conf_theme_window_status_fg='#c0caf5'              # tokyo night fg
tmux_conf_theme_window_status_bg='#1a1b26'              # tokyo night bg
tmux_conf_theme_window_status_attr='none'
tmux_conf_theme_window_status_format='#{circled_window_index} #W'

tmux_conf_theme_window_status_current_fg='#1a1b26'      # tokyo night bg
tmux_conf_theme_window_status_current_bg='#7aa2f7'      # tokyo night blue
tmux_conf_theme_window_status_current_attr='bold'
tmux_conf_theme_window_status_current_format='#{circled_window_index} #W'

tmux_conf_theme_window_status_activity_fg='default'
tmux_conf_theme_window_status_activity_bg='default'
tmux_conf_theme_window_status_activity_attr='underscore'

tmux_conf_theme_window_status_bell_fg='#f7768e'         # tokyo night red
tmux_conf_theme_window_status_bell_bg='default'
tmux_conf_theme_window_status_bell_attr='blink,bold'

tmux_conf_theme_window_status_last_fg='#737aa2'         # tokyo night dark5
tmux_conf_theme_window_status_last_bg='default'
tmux_conf_theme_window_status_last_attr='none'

tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

tmux_conf_theme_status_left=' 🌃 #S | ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} '

run-shell 'LOCAL_IP=""; \
case "$(uname -s)" in \
  Darwin) \
    iface=$(route -n get default 2>/dev/null | awk "/interface:/{print \$2}"); \
    [ -n "$iface" ] && LOCAL_IP=$(ipconfig getifaddr "$iface" 2>/dev/null); \
    [ -z "$LOCAL_IP" ] && LOCAL_IP=$(ipconfig getifaddr en0 2>/dev/null); \
    [ -z "$LOCAL_IP" ] && LOCAL_IP=$(ipconfig getifaddr en1 2>/dev/null); \
    ;; \
  Linux) \
    LOCAL_IP=$(ip route get 1.2.3.4 2>/dev/null | awk "{for(i=1;i<=NF;i++) if(\$i==\"src\"){print \$(i+1); exit}}"); \
    ;; \
esac; \
[ -z "$LOCAL_IP" ] && LOCAL_IP="N/A"; \
"${TMUX_PROGRAM:-tmux}" set -g @local_ip "$LOCAL_IP"'

run-shell 'OS_KEY="Unknown"; OS_BG="#a0a9cb"; OS_FG="#1d2230"; \
case "$(uname -s)" in \
  Darwin) OS_KEY="Macos"; OS_BG="#cccccc"; OS_FG="#1d2230" ;; \
  Linux) \
    OS_ID=$(. /etc/os-release 2>/dev/null && echo "$ID"); \
    case "$OS_ID" in \
      arch)        OS_KEY="Arch";        OS_BG="#1793d1"; OS_FG="#f8f8f2" ;; \
      nixos)       OS_KEY="NixOS";       OS_BG="#7ebae4"; OS_FG="#1d2230" ;; \
      ubuntu)      OS_KEY="Ubuntu";      OS_BG="#e95420"; OS_FG="#f8f8f2" ;; \
      debian)      OS_KEY="Debian";      OS_BG="#a81d33"; OS_FG="#f8f8f2" ;; \
      fedora)      OS_KEY="Fedora";      OS_BG="#3c6eb4"; OS_FG="#f8f8f2" ;; \
      linuxmint)   OS_KEY="Mint";        OS_BG="#87cf3e"; OS_FG="#1d2230" ;; \
      kali)        OS_KEY="Kali";        OS_BG="#557c94"; OS_FG="#f8f8f2" ;; \
      pop)         OS_KEY="Pop";         OS_BG="#48b9c7"; OS_FG="#1d2230" ;; \
      manjaro)     OS_KEY="Manjaro";     OS_BG="#35bf5c"; OS_FG="#1d2230" ;; \
      gentoo)      OS_KEY="Gentoo";      OS_BG="#54487a"; OS_FG="#f8f8f2" ;; \
      void)        OS_KEY="Void";        OS_BG="#478061"; OS_FG="#f8f8f2" ;; \
      alpine)      OS_KEY="Alpine";      OS_BG="#0d597f"; OS_FG="#f8f8f2" ;; \
      opensuse*)   OS_KEY="openSUSE";    OS_BG="#73ba25"; OS_FG="#1d2230" ;; \
      raspbian)    OS_KEY="Raspbian";    OS_BG="#c51a4a"; OS_FG="#f8f8f2" ;; \
      endeavouros) OS_KEY="EndeavourOS"; OS_BG="#7f3fbf"; OS_FG="#f8f8f2" ;; \
      *)           OS_KEY="Linux";       OS_BG="#fcc624"; OS_FG="#1d2230" ;; \
    esac ;; \
esac; \
STARSHIP_TOML="$HOME/.dotfiles/starship/.config/starship.toml"; \
OS_ICON=$(grep -m1 "^${OS_KEY} = " "$STARSHIP_TOML" 2>/dev/null | cut -d \" -f2 | sed "s/ //g"); \
[ -z "$OS_ICON" ] && OS_ICON="?"; \
SEP=$(printf "\356\202\262"); \
"${TMUX_PROGRAM:-tmux}" set -g @os_box "#[fg=#3b4261,bg=#7aa2f7]${SEP}#[fg=${OS_BG},bg=#3b4261]${SEP}#[fg=${OS_FG},bg=${OS_BG},bold] ${OS_ICON} #[fg=#7aa2f7,bg=${OS_BG}]${SEP}#[fg=#1a1b26,bg=#7aa2f7,bold]"'

tmux_conf_theme_status_right='#{prefix}#{pairing}#{synchronized} #{tasks_status} #{?battery_status, #{battery_status},}#{?battery_bar, #{battery_bar},}#{?battery_percentage, #{battery_percentage},} , %a %H:%M:%S , %d %b | #{username}#{root} #{@os_box} #{@local_ip} '

# status left style
tmux_conf_theme_status_left_fg='#1a1b26,#c0caf5,#1a1b26'  # tokyo night bg, fg, bg
tmux_conf_theme_status_left_bg='#e0af68,#3b4261,#7aa2f7'  # tokyo night yellow, fg_gutter, blue
tmux_conf_theme_status_left_attr='bold,none,none'

# status right style
tmux_conf_theme_status_right_fg='#c0caf5,#c0caf5,#1a1b26' # tokyo night fg, fg, bg
tmux_conf_theme_status_right_bg='#3b4261,#292e42,#7aa2f7' # tokyo night fg_gutter, bg_highlight, blue
tmux_conf_theme_status_right_attr='none,none,bold'

# pairing indicator
tmux_conf_theme_pairing='👓 '
tmux_conf_theme_pairing_fg='none'
tmux_conf_theme_pairing_bg='none'
tmux_conf_theme_pairing_attr='none'

# prefix indicator
tmux_conf_theme_prefix='⌨ '
tmux_conf_theme_prefix_fg='none'
tmux_conf_theme_prefix_bg='none'
tmux_conf_theme_prefix_attr='none'

# root indicator
tmux_conf_theme_root='!'
tmux_conf_theme_root_fg='red'
tmux_conf_theme_root_bg='none'
tmux_conf_theme_root_attr='bold,blink'

# synchronized indicator
tmux_conf_theme_synchronized='🔒'
tmux_conf_theme_synchronized_fg='none'
tmux_conf_theme_synchronized_bg='none'
tmux_conf_theme_synchronized_attr='none'

# battery bar symbols
tmux_conf_battery_bar_symbol_full='◼'
tmux_conf_battery_bar_symbol_empty='◻'

tmux_conf_battery_bar_length='auto'
tmux_conf_battery_bar_palette='gradient'
tmux_conf_battery_hbar_palette='gradient'
tmux_conf_battery_vbar_palette='gradient'

tmux_conf_battery_status_charging='🔌 '
tmux_conf_battery_status_discharging='🔋 '

tmux_conf_theme_clock_colour='#7dcfff'  # tokyo night cyan
tmux_conf_theme_clock_style='24'


# -- clipboard -----------------------------------------------------------------

tmux_conf_copy_to_os_clipboard=true


# -- user customizations -------------------------------------------------------

set -g mouse on
set -g status-right-length 200

# List of plugins
set -g @tpm_plugins '           \
    tmux-plugins/tpm            \
    tmux-plugins/tmux-sensible  \
    tmux-plugins/tmux-yank      \
    tmux-plugins/tmux-open      \
    chriszarate/tmux-tasks      \
'

set -g @tasks_manager 'taskwarrior'
set -g @tasks_format_begin '#[fg=#1a1b26,bg=#e0af68]'
set -g @tasks_format_end '#[fg=#c0caf5,bg=#292e42]'
set -g @tasks_icon_urgent '🔥'
set -g @tasks_icon_outstanding '+'


# -- custom variables ----------------------------------------------------------

# # /!\ do not remove the following line
# EOF
#
# # /!\ do not "uncomment" the functions: the leading "# " characters are needed
#
# weather() {
#   curl -f -s -m 2 'wttr.in?format=3' || printf '\n'
#   sleep 900
# }
#
# online() {
#   ping -c 1 1.1.1.1 >/dev/null 2>&1 && printf '✔' || printf '✘'
# }
#
# "$@"
# # /!\ do not remove the previous line

# -- shared base ---------------------------------------------------------------
source-file ~/.dotfiles/tmux/base.tmux.conf.local
