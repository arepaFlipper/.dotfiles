{
  "$schema": "https://opencode.ai/tui.json",
  "leader_timeout": 1500,
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command_list": "ctrl+k",
    "editor_open": "<leader>ctrl+e",
    "app_exit": [
      "ctrl+c",
      "ctrl+d"
    ]
  }
}
